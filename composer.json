{
  "name": "anubarak/craft-seeder",
  "description": "Easy entries seeder for Craft CMS",
  "version": "6.0.0-alpha.1",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "seeder"
  ],
  "license": "MIT",
  "require": {
    "craftcms/cms": "^6.0.0-alpha.1",
    "fakerphp/faker": "^1.24 || ^2.0.x-dev",
    "php": "^8.4",
    "ext-intl": "*"
  },
  "autoload": {
    "psr-4": {
      "anubarak\\seeder\\": "src/"
    }
  },
  "extra": {
    "name": "Element Seeder",
    "handle": "element-seeder",
    "class": "\\Anubarak\\Seeder\\SeederServiceProvider",
    "laravel": {
      "providers": [
        "\\Anubarak\\Seeder\\SeederServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "prefer-stable": true
}
